<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ImportEnvOptions>false</ImportEnvOptions>
    <DelphiLibraryPath>$(BDS)\lib\$(Platform)\release</DelphiLibraryPath>
